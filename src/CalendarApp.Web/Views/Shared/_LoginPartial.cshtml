@using Microsoft.AspNetCore.Identity
@using CalendarApp.Domain.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
  @if (SignInManager.IsSignedIn(User))
  {
    var currentUser = await UserManager.GetUserAsync(User);
    var displayName = currentUser != null ? $"{currentUser.FirstName} {currentUser.LastName}" : User.Identity?.Name;

    <li class="nav-item">
      <span class="nav-link text-dark">Ahoj, <strong>@displayName</strong>!</span>
    </li>
    <li class="nav-item">
      <form class="form-inline" asp-controller="Account" asp-action="Logout" method="post">
        <button type="submit" class="nav-link btn btn-link text-dark border-0">Odhlásiť sa</button>
      </form>
    </li>
  }
  else
  {
    <li class="nav-item">
      <a class="nav-link text-dark" asp-controller="Account" asp-action="Register">Registrácia</a>
    </li>
    <li class="nav-item">
      <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Prihlásiť sa</a>
    </li>
  }
</ul>